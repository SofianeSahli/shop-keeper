    {
      "name": "7. Payments",
      "item": [
        {
          "name": "Pay part of the purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
