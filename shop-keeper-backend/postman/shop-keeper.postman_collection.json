            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{cancellation_id}}\",\n  \"reason\": \"wrong amount\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
