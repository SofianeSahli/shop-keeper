{
  "info": {
    "name": "Shop Keeper API",
    "description": "Runs the whole journey in order against a local backend with AUTH_TEST_MODE=true and the catalog loaded (php artisan catalog:load). Set base_url, then run the collection; nothing needs editing. `test:<email>` stands in for Google and `000000` for every emailed code. Each run generates its own addresses, devices, barcodes and product ids.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "terms_version",
      "value": "2026-11",
      "type": "string"
    },
    {
      "key": "email_code",
      "value": "000000",
      "type": "string"
    },
    {
      "key": "password",
      "value": "first journey password",
      "type": "string"
    },
    {
      "key": "new_password",
      "value": "second journey password",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Google account",
      "item": [
        {
          "name": "First Google sign-in",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now();",
                  "pm.collectionVariables.set('google_email', `google.${runId}@gmail.com`);",
                  "pm.collectionVariables.set('email', `merchant.${runId}@example.com`);",
                  "pm.collectionVariables.set('device_id', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('new_device_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('signed_in');",
                  "});",
                  "pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"test:{{google_email}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"terms_version\": \"{{terms_version}}\",\n  \"phone\": \"+216 20 123 456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google"
              ]
            }
          }
        },
        {
          "name": "Read the account, no shop yet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('account with no shop', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.shop).to.eql(null);",
                  "  pm.expect(pm.response.json().data.phone).to.eql('+21620123456');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            }
          }
        },
        {
          "name": "Sign out of this device",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed out', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
