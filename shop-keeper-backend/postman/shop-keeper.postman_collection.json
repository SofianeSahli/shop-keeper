    {
      "name": "5. Products",
      "description": "Needs the catalog loaded (php artisan catalog:load). Uses the shop created in folder 2.",
      "item": [
        {
          "name": "Look up an unknown barcode",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const digits = '619' + Array.from({ length: 9 }, () => Math.floor(Math.random() * 10)).join('');",
                  "const sum = digits.split('').reverse().reduce((total, digit, position) => total + Number(digit) * (position % 2 === 0 ? 3 : 1), 0);",
                  "pm.collectionVariables.set('barcode', digits + ((10 - sum % 10) % 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('barcode unknown to the catalog', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('unknown');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/catalog/barcodes/{{barcode}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "barcodes",
                "{{barcode}}"
              ]
            }
          }
        },
        {
          "name": "Add it with a typed name",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('product_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('product added, barcode waiting to be checked', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().data.catalog_product.status).to.eql('pending');",
                  "  pm.expect(pm.response.json().data.catalog_product.names).to.eql(null);",
                  "});",
                  "pm.collectionVariables.set('barcode_product_id', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{product_id}}\",\n  \"barcode\": \"{{barcode}}\",\n  \"name\": \"Biscuit du quartier\",\n  \"language\": \"fr\",\n  \"sale_price\": 1200,\n  \"purchase_price\": 900\n}"
            }
          }
        },
        {
          "name": "Look it up again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('pending, already in the shop', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('pending');",
                  "  pm.expect(pm.response.json().data.shop_product.id).to.eql(pm.collectionVariables.get('barcode_product_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/catalog/barcodes/{{barcode}}",
              "host": [
                "{{base_url}}"
