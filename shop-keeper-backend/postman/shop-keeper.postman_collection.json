            "description": "Allowed now that its payment is cancelled; a purchase with payments still counting answers 409 transaction.has_payments. The product stock goes back down by 24.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{cancellation_id}}\",\n  \"reason\": \"wrong supplier\"\n}"
            }
          },
          "event": [
