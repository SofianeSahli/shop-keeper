            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{email_code}}\",\n  \"device_id\": \"{{device_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/email/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "email",
                "confirm"
              ]
            }
          }
        },
        {
          "name": "Create the shop",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('shop created in dinars', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().data.currency).to.eql('TND');",
                  "});",
                  "pm.collectionVariables.set('shop_id', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Epicerie Amira\",\n  \"business_type\": \"grocery\",\n  \"city\": \"Sousse\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/shops",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "shops"
              ]
            }
          }
        },
        {
          "name": "Read the shop",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('own shop returned', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('shop_id')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/shops/{{shop_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "shops",
                "{{shop_id}}"
              ]
            }
          }
        }
      ]
    },
