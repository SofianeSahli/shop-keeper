          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/transactions/{{transaction_id}}/cancellation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transaction_id}}",
                "cancellation"
