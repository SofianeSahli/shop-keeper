{
  "info": {
    "name": "Shop Keeper API",
    "description": "One request per API route. Import it with shop-keeper.postman_environment.json and select the \"Shop Keeper local\" environment. The backend runs with AUTH_TEST_MODE=true and the catalog loaded (php artisan catalog:load): `test:<email>` stands in for Google and `000000` for every emailed code. Run the folders in order the first time: tokens, ids, emails, devices and barcodes are saved in the environment, so any request can then be sent again on its own.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Accounts",
      "item": [
        {
          "name": "Sign in with Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google"
              ]
            },
            "description": "Starts a new Google account each time: google_email and device_id are generated before the request.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"test:{{google_email}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"terms_version\": \"{{terms_version}}\",\n  \"phone\": \"{{phone}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('google_email', `google.${Date.now()}@gmail.com`);",
                  "pm.environment.set('device_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('signed_in');",
                  "});",
                  "pm.environment.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign out of this device",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed out', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign up with email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/email/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "email",
                "register"
              ]
            },
            "description": "Starts a new email account each time: email, device_id and new_device_id are generated before the request.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{merchant_name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"terms_version\": \"{{terms_version}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('email', `merchant.${Date.now()}@example.com`);",
                  "pm.environment.set('device_id', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set('new_device_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code sent', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask for a new email code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/email/resend",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "email",
                "resend"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code sent', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm the email address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/email/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "email",
                "confirm"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{email_code}}\",\n  \"device_id\": \"{{device_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('signed_in');",
                  "});",
                  "pm.environment.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('account returned', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.email).to.eql(pm.environment.get('email'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Shop",
      "item": [
        {
          "name": "Create the shop",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/shops",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "shops"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{shop_name}}\",\n  \"business_type\": \"grocery\",\n  \"city\": \"{{shop_city}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('shop created in dinars', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().data.currency).to.eql('TND');",
                  "});",
                  "pm.environment.set('shop_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the shop",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/shops/{{shop_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "shops",
                "{{shop_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('own shop returned', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.id).to.eql(Number(pm.environment.get('shop_id')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Password and two-step sign-in",
      "item": [
        {
          "name": "Turn on two-step sign-in",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/me/two-factor",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "two-factor"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('two-step sign-in on', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot the password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/forgot",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "forgot"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code sent', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset the password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "reset"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{email_code}}\",\n  \"password\": \"{{new_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('password changed', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with email and password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/email/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "email",
                "login"
              ]
            },
            "description": "With two-step sign-in on, the answer is code_required and pending_sign_in is saved; otherwise the token is saved.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{new_password}}\",\n  \"device_id\": \"{{new_device_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.test('signed in or held for the code', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(data.status).to.be.oneOf(['signed_in', 'code_required']);",
                  "});",
                  "if (data.status === 'signed_in') {",
                  "  pm.environment.set('token', data.token);",
                  "} else {",
                  "  pm.environment.set('pending_sign_in', data.pending_sign_in);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask for a new sign-in code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/two-factor/resend",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "two-factor",
                "resend"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pending_sign_in\": \"{{pending_sign_in}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code sent', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send the sign-in code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/two-factor",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "two-factor"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pending_sign_in\": \"{{pending_sign_in}}\",\n  \"code\": \"{{email_code}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('signed_in');",
                  "});",
                  "pm.environment.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask for a code to turn off two-step sign-in",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/me/two-factor/disable-code",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "two-factor",
                "disable-code"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('code sent', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Turn off two-step sign-in",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/me/two-factor",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "two-factor"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{email_code}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('two-step sign-in off', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Products",
      "item": [
        {
          "name": "Look up a barcode",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/catalog/barcodes/{{barcode}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "barcodes",
                "{{barcode}}"
              ]
            },
            "description": "A new valid EAN-13 barcode, unknown to the catalog, is generated before the request."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const digits = '619' + Array.from({ length: 9 }, () => Math.floor(Math.random() * 10)).join('');",
                  "const sum = digits.split('').reverse().reduce((total, digit, position) => total + Number(digit) * (position % 2 === 0 ? 3 : 1), 0);",
                  "pm.environment.set('barcode', digits + ((10 - sum % 10) % 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('barcode looked up', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.be.oneOf(['unknown', 'pending', 'verified']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add a product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Adds the looked-up barcode with a typed name. A new product_id is generated before the request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{product_id}}\",\n  \"barcode\": \"{{barcode}}\",\n  \"name\": \"{{product_name}}\",\n  \"language\": \"fr\",\n  \"sale_price\": 1200,\n  \"purchase_price\": 900\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('product_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('product added', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('product_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Suggest products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products/suggestions?q={{search}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "suggestions"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{search}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('suggestions returned', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List the products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('products of the shop', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read one product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{product_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the product', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('product_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Change the prices",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{product_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sale_price\": 1900,\n  \"purchase_price\": 1300\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('new prices saved', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.sale_price).to.eql(1900);",
                  "  pm.expect(pm.response.json().data.purchase_price).to.eql(1300);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Contacts",
      "item": [
        {
          "name": "Add a contact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/contacts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "contacts"
              ]
            },
            "description": "A supplier with a phone. A new contact_id and a unique name are generated before the request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{contact_id}}\",\n  \"name\": \"{{contact_name}}\",\n  \"phone\": \"+216 98 123 456\",\n  \"is_supplier\": true\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('contact_id', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set('contact_name', 'Grossiste ' + Math.floor(Math.random() * 1000000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('contact added with a zero balance', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('contact_id'));",
                  "  pm.expect(pm.response.json().data.phone).to.eql('+21698123456');",
                  "  pm.expect(pm.response.json().data.balance).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark the contact as a customer too",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/contacts/{{contact_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "contacts",
                "{{contact_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_customer\": true,\n  \"address\": \"Rue de Marseille, Tunis\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('contact is now supplier and customer', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.is_supplier).to.eql(true);",
                  "  pm.expect(pm.response.json().data.is_customer).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/contacts?role=customer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "contacts"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "customer"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the contact is listed as a customer', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().data.map((contact) => contact.id);",
                  "  pm.expect(ids).to.include(pm.environment.get('contact_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the contact",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/contacts/{{contact_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "contacts",
                "{{contact_id}}"
              ]
            },
            "description": "The balance is what the shop owes the contact; below zero, what the contact owes the shop."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('contact read with its balance', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.name).to.eql(pm.environment.get('contact_name'));",
                  "  pm.expect(pm.response.json().data).to.have.property('balance');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Purchases",
      "item": [
        {
          "name": "Record a purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/transactions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions"
              ]
            },
            "description": "24 units of the product added in \"4. Products\", from the contact. The product stock grows by 24; its prices do not change. New transaction_id and line_id are generated before the request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{transaction_id}}\",\n  \"kind\": \"purchase\",\n  \"contact_id\": \"{{contact_id}}\",\n  \"reference\": \"BL-2041\",\n  \"lines\": [\n    {\n      \"id\": \"{{line_id}}\",\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 24,\n      \"unit_price\": 1200\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('transaction_id', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set('line_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('purchase recorded and unpaid', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().data.total).to.eql(28800);",
                  "  pm.expect(pm.response.json().data.payment_state).to.eql('unpaid');",
                  "  pm.expect(pm.response.json().data.lines.length).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List the purchases of the contact",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/transactions?kind=purchase&contact_id={{contact_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "purchase"
                },
                {
                  "key": "contact_id",
                  "value": "{{contact_id}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the purchase is listed', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data[0].id).to.eql(pm.environment.get('transaction_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the purchase",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/transactions/{{transaction_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transaction_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('purchase read with its lines and payments', () => {",
                  "  pm.response.to.have.status(200);",
